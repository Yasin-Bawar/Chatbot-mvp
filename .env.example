# Copy this file to .env.local and fill in the values.

# Required: your Anthropic API key (https://console.anthropic.com)
ANTHROPIC_API_KEY=

# Library database (Neon Postgres). Required on Vercel.
# Locally you can leave it empty: an embedded database is stored in ./.data
# (STORAGE_URL or POSTGRES_URL from the Vercel integration are accepted too.)
DATABASE_URL=

# Optional: Vercel Blob token, to keep the original PDF files
# (enables "open original page" and "read this page again with AI").
BLOB_READ_WRITE_TOKEN=

# Optional: 1 = let Claude read scanned / broken PDF pages (costs credits).
# Also requires a positive AI_BOOK_BUDGET_USD; otherwise only free text is saved.
# AI_BOOK_READING=1

# Optional: model used to read scanned / broken PDF pages (default: claude-sonnet-4-6).
# claude-haiku-5-5 is about 30x cheaper.
# OCR_MODEL=claude-sonnet-4-6

# Book-only lifetime spending allowance in US dollars (default 0 = paused).
# Existing book spending counts toward this cap. Chat and titles have no app cap.
# AI_BUDGET_USD is obsolete and ignored. Spending so far: /api/usage
AI_BOOK_BUDGET_USD=0

# Optional: 1 = canned demo answers, no API key needed (for UI development)
# MOCK_AI=1

# Optional: password for the whole website. Without it, anyone with the link can use the site.
# Several passwords are allowed, separated by commas (e.g. one per class).
# APP_PASSWORD=
# Optional: a long random string used to sign logins (default: derived from the passwords).
# AUTH_SECRET=

# Optional: natural voice for the voice teachers (Microsoft Azure Speech, free tier F0).
# Without these, the teachers use the browser's own speech (free; best in Chrome or Edge).
# AZURE_SPEECH_KEY=
# AZURE_SPEECH_REGION=westeurope
# AZURE_SPEECH_VOICE=fa-IR-DilaraNeural
