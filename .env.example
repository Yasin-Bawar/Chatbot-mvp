# Copy this file to .env.local and fill in the values.

# Required: your Anthropic API key (https://console.anthropic.com)
ANTHROPIC_API_KEY=

# Library database (Neon Postgres). Required on Vercel.
# Locally you can leave it empty: an embedded database is stored in ./.data
# (STORAGE_URL or POSTGRES_URL from the Vercel integration are accepted too.)
DATABASE_URL=

# Optional: Vercel Blob token, to keep the original PDF files
# (enables "open original page" and "read this page again with AI").
BLOB_READ_WRITE_TOKEN=

# Optional: model used to read scanned / broken PDF pages (default: claude-opus-5-5)
# OCR_MODEL=claude-opus-5-5

# Optional: 1 = canned demo answers, no API key needed (for UI development)
# MOCK_AI=1
